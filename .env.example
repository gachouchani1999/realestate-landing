# Public URL of the site (used for canonical + Open Graph URLs)
NEXT_PUBLIC_SITE_URL=https://propora.ae

# Where new leads are POSTed as JSON — e.g. a Zapier / Make catch hook, n8n, HubSpot or a Google Sheets script.
# If unset: leads are written to .data/leads.jsonl in development, and to the server logs in production.
LEAD_WEBHOOK_URL=

# Optional: where unfinished attempts (email + answers so far) are POSTed. Defaults to LEAD_WEBHOOK_URL.
# Payloads carry "event": "lead.partial"; the final submission sends "lead.submitted" with the same "id".
PARTIAL_LEAD_WEBHOOK_URL=
