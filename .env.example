# Public URL of the site (used for canonical + Open Graph URLs)
NEXT_PUBLIC_SITE_URL=https://baytouna.ae

# Optional: override the Google Analytics 4 measurement ID (defaults to the one in src/config/site.ts).
# The Google tag loads in production builds in consent mode: no cookies until a visitor accepts, cookieless pings before.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: override the Google Ads tag ID (defaults to the one in src/config/site.ts). Same consent mode.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Optional: override the Meta Pixel ID (defaults to the one in src/config/site.ts). The browser pixel only loads after
# a visitor accepts cookies.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API: reports every submitted lead to Meta from the server, so leads count without cookie consent.
# Create the token in Events Manager → your pixel → Settings → Conversions API → Generate access token.
# Leave blank to turn it off. Visitors who explicitly decline cookies are never sent.
META_CAPI_ACCESS_TOKEN=

# Optional: while testing, paste the code from Events Manager → Test events to see server events there. Remove after.
META_CAPI_TEST_EVENT_CODE=

# Optional: Graph API version for the Conversions API (defaults to v24.0).
META_GRAPH_VERSION=

# Where new leads are POSTed as JSON — e.g. a Zapier / Make catch hook, n8n, HubSpot or a Google Sheets script.
# If unset: leads are written to .data/leads.jsonl in development, and to the server logs in production.
LEAD_WEBHOOK_URL=

# Optional: where unfinished attempts (email + answers so far) are POSTed. Defaults to LEAD_WEBHOOK_URL.
# Payloads carry "event": "lead.partial"; the final submission sends "lead.submitted" with the same "id".
PARTIAL_LEAD_WEBHOOK_URL=
